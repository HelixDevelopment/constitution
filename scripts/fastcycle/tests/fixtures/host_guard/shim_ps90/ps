#!/bin/sh
# ps shim: fails unless called with -L (thread listing) AND -U <numeric REAL uid
# (`id -ru`; never a user NAME / the USER env var); then prints 90 lines
have=0; prev=""; uidok=0; me=$(id -ru)
for a in "$@"; do [ "$a" = "-L" ] && have=1; [ "$prev" = "-U" ] && [ "$a" = "$me" ] && uidok=1; prev=$a; done
[ "$have" = 1 ] || { echo "ps: shim requires -L" >&2; exit 1; }
[ "$uidok" = 1 ] || { echo "ps: shim requires -U <numeric real uid>" >&2; exit 1; }
i=0; while [ $i -lt 90 ]; do echo t; i=$((i+1)); done
