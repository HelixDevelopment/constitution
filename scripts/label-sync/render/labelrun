#!/usr/bin/env bash
# scripts/label-sync/render/labelrun
#
# Purpose : Run a command (or a multi-step flow) as a labelled label-sync entity.
#           Registers a `command`/`flow` entity under the current shell/session,
#           prints a one-line label banner to stderr (ONLY when stderr is a tty),
#           supervises the command WITHOUT exec (so it can clean up), propagates
#           its exit code EXACTLY, and marks the entity done on exit — including
#           when labelrun itself receives SIGTERM/SIGINT/SIGHUP/SIGQUIT.
# SIGNALS : a child started with `&` by a non-interactive bash inherits SIGINT
#           and SIGQUIT IGNORED, so Ctrl-C could never stop it (review finding 4).
#           labelrun therefore starts the child through
#           `env --default-signal=INT,QUIT` (fallback: perl resetting $SIG{INT,QUIT};
#           if neither exists the child runs with the inherited dispositions and
#           LABEL_SYNC_DEBUG=1 says so). TERM and HUP are always forwarded to the
#           child pid. INT/QUIT are forwarded UNLESS the child is in the terminal's
#           foreground process group — then the terminal already delivered the
#           same Ctrl-C to it, and a second copy would be a double interrupt. A
#           `kill -INT <labelrun>` from anywhere else is forwarded (tested: the
#           child ends within 1.5 s and labelrun exits 130).
# Usage   : labelrun [--kind command|flow] [--name NAME] -- cmd [args...]
# Inputs  : env LABEL_SYNC_SHELL_ID (parent entity, exported by the shell
#           integrations; else LABEL_SYNC_PARENT_ID), CLAUDE_CODE_SESSION_ID,
#           LABEL_SYNC_DIR, LABEL_SYNC_LABELCTL. Child stdin/stdout/stderr are
#           passed through untouched.
# Outputs : the child's own output; plus `labelrun: <label> <name>` on stderr when
#           stderr is a tty. NAME is recorded in the entity `source` as
#           `labelrun:name=<name>` (sanitised); command arguments are NEVER
#           recorded or printed (they may carry secrets, §11.4.10).
# Exit    : the child's exit status verbatim (127 command not found, 126 not
#           executable, 128+N killed by signal N: 130 INT, 143 TERM). 2 for
#           labelrun usage errors. The command must be an executable program
#           (it is exec'd by env); a bash builtin with no program of the same
#           name (e.g. `labelrun -- cd`) is run directly by this bash instead.
#           FAIL-SOFT: if the state dir / labelctl is unusable the command still
#           runs and its exit code is still propagated (a label is cosmetic;
#           labelrun must never be the reason a build fails).
# Side-effects: register + unregister via labelctl; the entity pid is labelrun's
#           own pid (alive for the whole run => never stale, CONTRACT §6). A
#           SIGKILL'd labelrun cannot clean up: its entity goes stale on TTL.
#           Signals are forwarded to the single child pid we started (never a
#           process group, §11.4.263).
# Deps    : bash>=4, labelctl.sh.
# Cross-refs: §11.4.182, §11.4.232 (long-op registry, same discipline),
#           §11.4.263, docs/label-sync/RENDERERS.md.
# Classification: universal (§11.4.17).
set -u
RDIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=lib.sh
. "$RDIR/lib.sh" || exit 2
usage() { sed -n '2,/^# Classification/p' "$0" | sed 's/^# \{0,1\}//'; }
kind=command name=""
while [ $# -gt 0 ]; do
  case "$1" in
    --kind) kind="${2:-}"; shift 2 ;;
    --name) name="${2:-}"; shift 2 ;;
    --) shift; break ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "labelrun: unknown option '$1'" >&2; exit 2 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { usage >&2; exit 2; }
case "$kind" in command|flow) ;; *) echo "labelrun: --kind must be command|flow" >&2; exit 2 ;; esac

LCTL="$(ls_labelctl)"
__h="${HOSTNAME:-host}"; __h="${__h//[^A-Za-z0-9.-]/-}"        # id grammar has no `_`
id="run-${__h:0:60}-$$-${EPOCHSECONDS:-0}"
src="labelrun"; [ -n "$name" ] && src="labelrun:name=${name//[^A-Za-z0-9._+-]/_}"
parent="${LABEL_SYNC_SHELL_ID:-${LABEL_SYNC_PARENT_ID:-}}"
args=(register --id "$id" --kind "$kind" --pid "$$" --cwd "$PWD" --source "$src")
[ -n "$parent" ] && args+=(--parent "$parent")
[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && args+=(--session "$CLAUDE_CODE_SESSION_ID")
registered=0 label=""
if [ -x "$LCTL" ] && label="$("$LCTL" "${args[@]}" 2>/dev/null)"; then registered=1; fi

if [ -t 2 ] && [ "$registered" = 1 ]; then
  disp="${name:-${1##*/}}"
  printf 'labelrun: %s %s\n' "$(ls_sanitize "$label")" "$(ls_sanitize "$disp")" >&2
fi

child=0
# Single child pid only, validated > 1 — never a process group (§11.4.263).
fwd() { case "$child" in ''|*[!0-9]*) return 0 ;; esac; [ "$child" -gt 1 ] && kill -s "$1" "$child" 2>/dev/null; return 0; }
# INT/QUIT: forward unless the child sits in the terminal's foreground process
# group (the tty already sent it the same signal). /proc/<pid>/stat after the
# last ')': state ppid pgrp session tty_nr tpgid ...
fwd_tty() {
  local st rest f
  case "$child" in ''|*[!0-9]*) return 0 ;; esac
  if { IFS= read -r st <"/proc/$child/stat"; } 2>/dev/null; then
    rest="${st##*) }"; read -r -a f <<<"$rest"
    if [ "${f[5]:-0}" -gt 0 ] 2>/dev/null && [ "${f[2]:-x}" = "${f[5]}" ]; then return 0; fi
  fi
  fwd "$1"
}
cleanup() { [ "$registered" = 1 ] && "$LCTL" unregister --id "$id" >/dev/null 2>&1; return 0; }
trap 'fwd TERM' TERM
trap 'fwd_tty INT' INT
trap 'fwd_tty QUIT' QUIT
trap 'fwd HUP' HUP
trap cleanup EXIT

# Restore default INT/QUIT in the child (a `&` child of a non-interactive bash
# inherits them ignored). Probe once; never assume (§11.4.6).
runner=()
if env --default-signal=INT,QUIT true >/dev/null 2>&1; then
  runner=(env --default-signal=INT,QUIT)
elif command -v perl >/dev/null 2>&1; then
  runner=(perl -e '$SIG{INT}="DEFAULT"; $SIG{QUIT}="DEFAULT"; exec { $ARGV[0] } @ARGV or exit(($!{ENOENT}) ? 127 : 126);')
else
  [ "${LABEL_SYNC_DEBUG:-}" = 1 ] && echo "labelrun: no env --default-signal and no perl: child keeps inherited SIGINT disposition" >&2
fi
if [ "$(type -t -- "$1" 2>/dev/null)" = builtin ] && [ -z "$(type -P -- "$1" 2>/dev/null)" ]; then
  runner=()                                     # a pure builtin cannot be exec'd
fi

"${runner[@]}" "$@" <&0 &
child=$!
wait "$child"; rc=$?
# a trapped signal makes `wait` return early while the child lives: keep supervising
while kill -0 "$child" 2>/dev/null; do wait "$child"; rc=$?; done
exit "$rc"
