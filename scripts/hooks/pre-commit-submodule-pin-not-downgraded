#!/usr/bin/env bash
# Git pre-commit hook (CON-046): refuse a commit that moves a staged submodule gitlink back to an ancestor.
# Install (operator consent): ln -s <path-to>/scripts/hooks/pre-commit-submodule-pin-not-downgraded .git/hooks/pre-commit
# The gate is resolved relative to THIS file's real path (constitution layout, also when vendored as constitution/).
# Run from a copy or any layout without ../gates/…: prints an honest SKIP and does not block (nothing is guarded then).
# Guards only commits that run git hooks (not --no-verify, merge/cherry-pick/revert/rebase). BLIND (2) blocks (fail closed).
# Base is always HEAD: git does not tell a pre-commit hook about --amend (see the gate header). A waiver row counts only
# in the commit that adds it (the gate header lists every waiver rule).
# If the gate later disappears from beside a symlinked hook, the hook prints SKIP on stderr and no longer guards.
self="$(readlink -f "${BASH_SOURCE[0]:-$0}")"; gate="$(dirname "$self")/../gates/cm_submodule_pin_not_downgraded.sh"
if [ ! -r "$gate" ]; then
  echo "CM-SUBMODULE-PIN-NOT-DOWNGRADED: SKIP — gate not found beside this hook ($gate); install by SYMLINK into the constitution layout. NOT GUARDED." >&2; exit 0; fi
root="$(git rev-parse --show-toplevel)" || exit 1
exec bash "$gate" --root "$root"
