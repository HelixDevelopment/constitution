#!/usr/bin/env bash
# Git pre-commit hook (CON-046): refuse a commit that moves a staged submodule gitlink back to an ancestor.
# Install (operator consent): ln -s <path-to>/scripts/hooks/pre-commit-submodule-pin-not-downgraded .git/hooks/pre-commit
# The gate is resolved relative to THIS file's real path (constitution layout, also when vendored as constitution/).
# Run from a copy or any layout without ../gates/…: prints an honest SKIP and does not block (nothing is guarded then).
# Guards only commits that run git hooks (not --no-verify, merge, a clean cherry-pick/revert, or rebase clean or after a
# conflict). Not caught (a local check cannot see it): `reset --soft HEAD~2 && commit -a` over a reviewed rollback and an
# index-only forward with a stale submodule checkout re-lands the old pin as WAIVED; commit without -a, or run
# `git submodule update` first (the gate header lists every such residual). BLIND (2) blocks
# (fail closed). Base is always HEAD: git does not tell a pre-commit hook about --amend (see the gate header). A waiver
# row waives one transition in one single-parent commit on top of the commit the row names (the gate header has the rule).
# Needs bash and GNU readlink (`readlink -f`); without them the gate is not found and the hook prints SKIP (not guarded).
# If the gate later disappears from beside a symlinked hook, the hook prints SKIP on stderr and no longer guards.
# Locale: the gate exports LC_ALL=C itself (round 13, review r12 N1), so its verdict is the same under any caller
# locale; this hook's own commands (readlink -f, dirname, git rev-parse) compare nothing (paired test: HLOC13).
self="$(readlink -f "${BASH_SOURCE[0]:-$0}")"; gate="$(dirname "$self")/../gates/cm_submodule_pin_not_downgraded.sh"
if [ ! -r "$gate" ]; then
  echo "CM-SUBMODULE-PIN-NOT-DOWNGRADED: SKIP — gate not found beside this hook ($gate); install by SYMLINK into the constitution layout. NOT GUARDED." >&2; exit 0; fi
root="$(git rev-parse --show-toplevel)" || exit 1
exec bash "$gate" --root "$root"
